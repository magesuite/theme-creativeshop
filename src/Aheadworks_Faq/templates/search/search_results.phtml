<?php
/**
 * Template overridden in order to:
 * - add magesuite classes
 * - add icon
 * Aligned with Aheadworks_Faq v1.8.0 in 06/2026
 */

// @codingStandardsIgnoreFile

/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var \Aheadworks\Faq\ViewModel\Search\SearchResults\AbstractSearchResults $viewModel */
$viewModel = $block->getViewModel();
$articles = $viewModel->getArticles();
$categories = $viewModel->getCategories();
?>
<div class="cs-faq-index__search-results">
    <div class="cs-faq-index__results-list">
        <?php if ($errorMessage = $viewModel->getErrorMessage()): ?>
            <div class="message notice">
                <div><?= $escaper->escapeHtml($errorMessage) ?></div>
            </div>
        <?php endif; ?>
        <?php if ($articles || $categories): ?>
            <h3><?= $escaper->escapeHtml(__(
                    'We have found %1 articles for "%2" search query:',
                    [count($articles), $viewModel->getSearchQuery()]
                )) ?>
            </h3>
            <ul class="cs-faq-index__list">
                <?php foreach ($articles as $article): ?>
                    <li class="cs-faq-index__list-item">
                        <a href="<?= $escaper->escapeUrl($viewModel->getArticleUrl($article)) ?>"
                           title="<?= $escaper->escapeHtmlAttr(__('Go to %1', $article->getTitle())) ?>">
                            <?= /* @noEscape */ $viewModel->highlightSearchQueryWords($escaper->escapeHtml($article->getTitle())) ?>
                            <?= $block->getChildHtml('aw_faq.search_results.icon') ?>
                        </a>
                    </li>
                <?php endforeach; ?>
            </ul>
        <?php else: ?>
            <h3><?= $escaper->escapeHtml(__('No results found.')) ?></h3>
            <div>
                <?= /* @noEscape */ __('Try searching something else or <a href="%1">go back</a> to previous page.', $escaper->escapeUrl($viewModel->getBackUrl())) ?>
            </div>
        <?php endif; ?>
    </div>
</div>
