<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block name="catalogsearch.results.switcher" template="Smile_ElasticsuiteCms::switcher.phtml" after="category.page.headline">
                <arguments>
                    <argument name="areas" xsi:type="array">
                        <item name="all" xsi:type="array">
                            <item name="additional_css" xsi:type="string">cs-tabs__title--active</item>
                            <item name="title_id" xsi:type="string">tab-all-title</item>
                            <item name="title_href" xsi:type="string">#all</item>
                            <item name="count_id" xsi:type="string">count-all</item>
                            <item name="label" xsi:type="string" translate="true">All results</item>
                            <item name="sort_order" xsi:type="number">10</item>
                        </item>
                        <item name="pages" xsi:type="array">
                            <item name="title_id" xsi:type="string">tab-cmspages-title</item>
                            <item name="title_href" xsi:type="string">#tab-content-cmspages</item>
                            <item name="count_id" xsi:type="string">count-cms</item>
                            <item name="label" xsi:type="string" translate="true">Pages</item>
                            <item name="sort_order" xsi:type="number">20</item>
                        </item>
                        <item name="products" xsi:type="array">
                            <item name="title_id" xsi:type="string">tab-products-title</item>
                            <item name="title_href" xsi:type="string">#tab-content-products</item>
                            <item name="count_id" xsi:type="string">count-products</item>
                            <item name="label" xsi:type="string" translate="true">Products</item>
                            <item name="sort_order" xsi:type="number">30</item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceBlock name="category.page.headline" template="Smile_ElasticsuiteCms::headline.phtml"/>
        <referenceBlock name="search.result" template="Smile_ElasticsuiteCms::products_result.phtml"/>
    </body>
</page>
