<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="suggest.brand">
            <block class="MageSuite\ThemeHelpers\Block\Icon" name="suggest.brand.icon" as="item_icon">
                <arguments>
                    <argument name="icon_url" xsi:type="string">images/icons/cms/brand.svg</argument>
                    <argument name="css_class" xsi:type="string">cs-search-results-cms__icon</argument>
                    <argument name="lazy_loaded" xsi:type="boolean">false</argument>
                    <argument name="inlined" xsi:type="boolean">true</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
