<?php
// @codingStandardsIgnoreFile
/**
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */
$level = $block->getLevel();
$nextIcon = $block->getNextIcon();
$prevIcon = $block->getPrevIcon();
$showCategoryIconSubcats = $block->getShowCategoryIconSubcats();
$showParentOnReturnLink = $block->getShowParentOnReturnLink();
$showIconOnReturnLink = $block->getShowIconOnReturnLink();

$item = $block->getItem();
$itemUrl = $item->getUrl();
$itemLabel = $item->getLabel();
$itemIdentifier = $item->getIdentifier() ?? '';

$parent = $block->getParent();
$parentLabel = $parent ? $parent->getLabel() : false;
$itemCategoryIcon = $item->getCategoryIcon();
?>
<ul class="cs-offcanvas-navigation__list cs-offcanvas-navigation__list--level_<?= $escaper->escapeHtmlAttr($level); ?>">
    <li class="cs-offcanvas-navigation__item"
        <?php if ($itemIdentifier) : ?>
            data-category-identifier="<?= $escaper->escapeHtmlAttr($itemIdentifier); ?>"
        <?php endif; ?>
    >
        <a class="cs-offcanvas-navigation__link cs-offcanvas-navigation__link--return<?= !$prevIcon ? ' cs-offcanvas-navigation__link--prev' : '' ?>"
           href="<?= $escaper->escapeUrl($itemUrl); ?>"
        >
            <?php if ($prevIcon) : ?>
                <?= $prevIcon ?>
            <?php endif; ?>
            <?php if ($showParentOnReturnLink && $parentLabel) : ?>
                <span class="cs-offcanvas-navigation__text-parent">
                    <?= $escaper->escapeHtml($parentLabel); ?>
                </span>
            <?php endif; ?>
            <?php if ($showIconOnReturnLink && $itemCategoryIcon) : ?>
                <span class="cs-offcanvas-navigation__category-icon-wrapper">
                    <img src="<?= $escaper->escapeUrl($itemCategoryIcon); ?>" alt="<?= $escaper->escapeHtmlAttr($itemLabel); ?>" class="cs-offcanvas-navigation__category-icon">
                </span>
            <?php endif; ?>
            <span class="cs-offcanvas-navigation__text">
                <?= $escaper->escapeHtml($itemLabel); ?>
            </span>
        </a>
    </li>
    <?php if (!$item->isUrlDisabled()) : ?>
        <li class="cs-offcanvas-navigation__item cs-offcanvas-navigation__item--all-products">
            <a class="cs-offcanvas-navigation__link" href="<?= $escaper->escapeUrl($itemUrl); ?>"><?= $escaper->escapeHtml(__('All products')); ?></a>
        </li>
    <?php endif; ?>
<?php
foreach ($item->getSubItems() as $subItem) :
    $subItem = $subItem;
    $subItemId = $subItem->getId();
    $subItemUrl = $subItem->getUrl();
    $subItemLabel = $subItem->getLabel();
    $subItemIdentifier = $subItem->getIdentifier() ?? '';
    $subItemHasSubItems = $subItem->hasSubItems();
    $subItemCategoryIcon = $showCategoryIconSubcats ? $subItem->getCategoryIcon() : '';
    $itemNextAdditionalClasses = '';

    if ($subItemHasSubItems) {
        $itemNextAdditionalClasses .= ' cs-offcanvas-navigation__link--parent';

        if (!$nextIcon) {
            $itemNextAdditionalClasses .= '  cs-offcanvas-navigation__link--next';
        }
    }
?>
    <li class="cs-offcanvas-navigation__item cs-offcanvas-navigation__item--level_<?= $escaper->escapeHtmlAttr($level); ?>"
        <?php if ($subItemIdentifier) : ?>
            data-category-identifier="<?= $escaper->escapeHtmlAttr($subItemIdentifier); ?>"
        <?php endif; ?>
    >
        <a
            class="cs-offcanvas-navigation__link<?= $escaper->escapeHtmlAttr($itemNextAdditionalClasses); ?>"
            href="<?= $escaper->escapeUrl($subItemUrl); ?>"
            data-category-id="<?= $escaper->escapeHtmlAttr($subItemId); ?>"
        >
            <?php if ($subItemHasSubItems && $nextIcon) : ?>
                <?= $nextIcon ?>
            <?php endif; ?>
            <?php if ($subItemCategoryIcon) : ?>
                <span class="cs-offcanvas-navigation__category-icon-wrapper">
                    <img src="<?= $escaper->escapeUrl($subItemCategoryIcon); ?>" alt="<?= $escaper->escapeHtmlAttr($subItemLabel); ?>" class="cs-offcanvas-navigation__category-icon">
                </span>
            <?php endif; ?>
            <span class="cs-offcanvas-navigation__text">
                <?= $escaper->escapeHtml($subItemLabel); ?>
            </span>
        </a>
        <?php
            if ($subItemHasSubItems) {
                echo $this->getLayout()
                    ->createBlock(Magento\Framework\View\Element\Template::class)
                    ->setTemplate("MageSuite_Navigation::offcanvas/list.phtml")
                    ->setItem($subItem)
                    ->setParent($item)
                    ->setLevel($level + 1)
                    ->setNextIcon($block->getNextIcon())
                    ->setPrevIcon($block->getPrevIcon())
                    ->setShowCategoryIconSubcats($showCategoryIconSubcats)
                    ->setShowParentOnReturnLink($showParentOnReturnLink)
                    ->toHtml();
            }
        ?>
    </li>
<?php endforeach; ?>
</ul>
