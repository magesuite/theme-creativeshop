<?php
/**
 * Template overridden to
 * - remove title
 * - add hotspots: form_fields_before, hotspot.after.fieldset
 * - add magesuite classes
 * - add cs-star-rating__form-stars element
 * - remove data-bind: scope from form element. This is a Magento bug, knockout component is initialized twice,
 * and data-scope clear all events on form (f.e. swatches clicks)
 *
 * Aligned with Magento 2.4.8 in 05/2025
 */

/** @var \Magento\Review\Block\Form $block */
/** @var \Magento\Framework\View\Element\ButtonLockManager|null $buttonLockManager */
$buttonLockManager = $block->getData('button_lock_manager');
/** @var $escaper \Magento\Framework\Escaper */

$useCssStars = $block->getVar('star-rating/use-css-mask-for-stars', 'Magento_Review');
//phpcs:disable Generic.Files.LineLength
?>
<?php if ($block->getAllowWriteReviewFlag()):?>
<form action="<?= $escaper->escapeUrl($block->getAction()) ?>" class="cs-form | cs-reviews__form" method="post" id="review-form" data-role="product-review-form">
    <?= $block->getBlockHtml('formkey') ?>
    <h3 class="cs-reviews__headline">
        <?= $escaper->escapeHtml(__("You're reviewing:")) ?>
        <span class="cs-reviews__product-name">
            <?= $escaper->escapeHtml($block->getProductInfo()->getName()) ?>
        </span>
    </h3>
    <div class="cs-reviews__options">
        <?= $block->getChildHtml('form_fields_before')?>
        <?php $ratings = $block->getRatings(); ?>
        <?php if ($ratings && $ratings->getSize()): ?>
            <div class="cs-reviews__ratings" data-hasrequired="<?php __('* Required Fields'); ?>">
                <div id="input-message-box"></div>
                <div class="cs-reviews__rating" id="product-review-table">
                    <?php foreach ($ratings as $rating): ?>
                        <div class="cs-reviews__rating-item">
                            <div class="field required">
                                <?php
                                    $options = $rating->getOptions();
                                    $msg = __('Select your rating');
                                    $getRatingCode = $rating->getRatingCode();
                                ?>
                                <!-- Rating code name should be translated in admin panel Stores > Rating, not in this template -->
                                <div class="label">
                                    <span><?= /* @escapeNotVerified */ count($ratings) == 1 ? __("Your rating") : $rating->getRatingCode(); ?>:</span>
                                </div>
                            </div>
                            <div class="cs-reviews__rating-control | review-control-vote">
                                <span class="cs-reviews__rate-feedback" data-default-message="<?= /* @escapeNotVerified */ $msg ?>"><?=/* @escapeNotVerified */$msg?></span>
                                <div class="cs-star-rating__form-stars" role="radiogroup" aria-label="<?= $block->escapeHtmlAttr($msg) ?>">
                                    <?php $iterator = 1; foreach ($options as $option): ?>
                                        <?php $optionValue = $option->getValue(); ?>

                                        <?php switch ($optionValue) {
                                            case 1:
                                                $msg = __('Very bad');
                                                break;
                                            case 2:
                                                $msg = __('Bad');
                                                break;
                                            case 3:
                                                $msg = __('Could be better');
                                                break;
                                            case 4:
                                                $msg = __('Good');
                                                break;
                                            case 5:
                                                $msg = __('Very good!');
                                                break;
                                            default:
                                                $msg = __('Click on stars to rate');
                                        } ?>

                                        <input
                                            type="radio"
                                            name="ratings[<?= $escaper->escapeHtmlAttr($rating->getId()) ?>]"
                                            id="<?= $escaper->escapeHtmlAttr($getRatingCode) ?>_<?= $escaper->escapeHtmlAttr($optionValue) ?>"
                                            value="<?= $escaper->escapeHtmlAttr($option->getId()) ?>"
                                            class="radio"
                                            data-validate="{'rating-required':true}"
                                            data-feedback-message="<?= /* @escapeNotVerified */ $msg ?>"
                                            aria-labelledby="<?= $escaper->escapeHtmlAttr($getRatingCode) ?>_<?= $escaper->escapeHtmlAttr($optionValue) ?>_label">
                                        <label
                                            class="cs-reviews__rate-stars rating-<?= $escaper->escapeHtmlAttr($iterator) ?>"
                                            for="<?= $escaper->escapeHtmlAttr($getRatingCode) ?>_<?= $escaper->escapeHtmlAttr($optionValue) ?>"
                                            title="<?= $escaper->escapeHtmlAttr(__('%1 %2', $iterator, $iterator > 1 ? 'stars' : 'star')) ?>"
                                            id="<?= $escaper->escapeHtmlAttr($getRatingCode) ?>_<?= $escaper->escapeHtmlAttr($optionValue) ?>_label"
                                        >
                                            <?php if ($useCssStars): ?>
                                                <i class="<?= 'cs-star-rating__form-star ' . $optionValue ?>" aria-hidden="true"></i>
                                            <?php else: ?>
                                                <?= $this->getLayout()
                                                    ->createBlock('MageSuite\ThemeHelpers\Block\Icon')
                                                    ->setIconUrl('images/icons/reviews/star.svg')
                                                    ->setCssClass('cs-star-rating__form-star ' . $optionValue)
                                                    ->setInlined(true)
                                                    ->toHtml();
                                                ?>
                                            <?php endif; ?>

                                            <span><?= $escaper->escapeHtmlAttr(__('%1 %2', $iterator, $iterator > 1 ? 'stars' : 'star')) ?></span>
                                        </label>
                                        <?php $iterator++; ?>
                                    <?php endforeach; ?>
                                </div>
                            </div>
                        </div>
                    <?php endforeach; ?>
                </div>
            </div>
        <?php endif ?>
    </div>

    <div class="cs-reviews__fieldset" data-hasrequired="<?php __('* Required Fields'); ?>" data-bind="scope: 'review-form'" data-role="product-review-form-fieldset">
        <div class="field required">
            <label for="nickname_field" class="label">
                <span><?= $escaper->escapeHtml(__('Nickname')) ?>:</span>
            </label>
            <div class="control">
                <input
                    type="text"
                    name="nickname"
                    id="nickname_field"
                    class="input-text"
                    data-validate="{required:true}"
                    data-bind="value: nickname()"
                    autocomplete="given-name">
            </div>
        </div>

        <div class="field required">
            <label for="summary_field" class="label">
                <?= $escaper->escapeHtml(__('Summary')) ?>:
            </label>
            <div class="control">
                <input
                    type="text"
                    name="title"
                    id="summary_field"
                    class="input-text"
                    data-validate="{required:true}"
                    data-bind="value: review().title"
                    autocomplete="off">
            </div>
        </div>

        <div class="field required">
            <label for="review_field" class="label">
                <?= $escaper->escapeHtml(__('Review')) ?>:
            </label>
            <div class="control">
                <textarea
                    name="detail"
                    class="cs-reviews__review-field"
                    id="review_field"
                    data-validate="{required:true}"
                    data-bind="value: review().detail"
                    autocomplete="off"></textarea>
            </div>
        </div>
    </div>

    <?= $block->getChildHtml('hotspot.after.fieldset')?>
    <?= $block->getChildHtml('form_additional_review_info') ?>

    <div class="cs-reviews__submit cs-form__buttons">
        <button type="submit" class="cs-form__button cs-reviews__submit-button"
            <?php if ($buttonLockManager?->isDisabled('review_form_submit')): ?>
                disabled="disabled"
            <?php endif; ?>>
            <span class="cs-form__button-span"><?= $escaper->escapeHtml(__('Submit Review')) ?></span>
            <?= $block->getChildHtml('product.review.form.button.icon'); ?>
        </button>
    </div>
</form>
<script type="text/x-magento-init">
{
    "[data-role=product-review-form]": {
        "Magento_Ui/js/core/app": <?= /* @noEscape */ $block->getJsLayout() ?>
    },
    "#review-form": {
        "Magento_Review/js/error-placement": {},
        "Magento_Review/js/validate-review": {},
        "Magento_Review/js/submit-review": {}
    }
}
</script>
<?php else: ?>
    <div class="cs-reviews__login-msg" id="review-form">
    <?= $escaper->escapeHtml(__('Only registered users can write reviews. Please <a href="%1">Sign in</a> or <a href="%2">create an account</a>', $block->getLoginLink(), $block->getRegisterUrl()), ['a']) ?>
    </div>
<?php endif ?>
